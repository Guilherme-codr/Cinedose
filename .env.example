# Copie este arquivo para ".env.local" e preencha com as suas chaves.
# O ".env.local" já é ignorado pelo Git (veja o .gitignore), então a chave não vai para o GitHub.

# OMDb: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_KEY=

# TMDB (opcional, traz título, sinopse e elenco em português): https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=
